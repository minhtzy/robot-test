{
  "name": "robot-testkit-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Robot Testkit.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:stdio": "npm run build && node dist/src/server.js --transport stdio",
    "start:http": "npm run build && node dist/src/server.js --transport http --port 3333",
    "test": "node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
